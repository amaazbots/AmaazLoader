<Window x:Class="AmaazLoader.PairingManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pairing Tools - AmaazLoader"
        Icon="Assets/AmaazLoader.ico"
        Width="720"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#050506"
        Foreground="#F5F5F7">

    <Window.Resources>

        <Style x:Key="PairingCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#0E0E11"/>
            <Setter Property="BorderBrush"
                    Value="#242429"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="18"/>
            <Setter Property="Padding"
                    Value="20"/>
        </Style>

        <Style x:Key="PairingButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#F5F5F7"/>
            <Setter Property="Foreground"
                    Value="#080809"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="18,10"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="PairingButtonSecondary"
               TargetType="Button"
               BasedOn="{StaticResource PairingButton}">
            <Setter Property="Background"
                    Value="#18181D"/>
            <Setter Property="Foreground"
                    Value="#F5F5F7"/>
            <Setter Property="BorderBrush"
                    Value="#303036"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

    </Window.Resources>


    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">

            <TextBlock Text="PAIRING TOOLS"
                       Foreground="#6A6A72"
                       FontSize="10"
                       FontWeight="Bold"/>

            <TextBlock Text="SideStore &amp; LiveContainer"
                       Foreground="#F5F5F7"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,7,0,0"/>

            <TextBlock Text="AmaazLoader can generate the pairing data on your computer and place it directly inside supported apps. Nothing is uploaded."
                       Foreground="#777780"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>


        <Grid Grid.Row="1"
              Margin="0,0,0,14">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    Style="{StaticResource PairingCard}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="SideStore"
                                   Foreground="#F5F5F7"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SideStorePairingStatusText"
                                   Text="Not scanned"
                                   Foreground="#6F6F77"
                                   FontSize="10"
                                   Margin="0,7,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Place"
                            Style="{StaticResource PairingButtonSecondary}"
                            Click="PlaceSideStoreButton_Click"
                            VerticalAlignment="Center"/>

                </Grid>

            </Border>


            <Border Grid.Column="2"
                    Style="{StaticResource PairingCard}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="LiveContainer"
                                   Foreground="#F5F5F7"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="LiveContainerPairingStatusText"
                                   Text="Not scanned"
                                   Foreground="#6F6F77"
                                   FontSize="10"
                                   Margin="0,7,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Place"
                            Style="{StaticResource PairingButtonSecondary}"
                            Click="PlaceLiveContainerButton_Click"
                            VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>


        <Border Grid.Row="2"
                Style="{StaticResource PairingCard}"
                Margin="0,0,0,14">

            <StackPanel>

                <TextBlock Text="AUTOMATIC SETUP"
                           Foreground="#6A6A72"
                           FontSize="10"
                           FontWeight="Bold"/>

                <TextBlock Text="Place the pairing file in every supported app currently installed on your device."
                           Foreground="#B0B0B7"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,14"/>

                <Button x:Name="PlaceAllButton"
                        Content="Place in SideStore &amp; LiveContainer"
                        Style="{StaticResource PairingButton}"
                        Click="PlaceAllButton_Click"/>

            </StackPanel>

        </Border>


        <Border Grid.Row="3"
                Style="{StaticResource PairingCard}">

            <StackPanel>

                <TextBlock Text="PAIRING STATUS"
                           Foreground="#6A6A72"
                           FontSize="10"
                           FontWeight="Bold"/>

                <TextBlock x:Name="PairingStatusText"
                           Text="Connect your iPhone with USB, unlock it, and press Rescan."
                           Foreground="#F5F5F7"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0"/>

                <TextBlock x:Name="PairingDetailsText"
                           Text="AmaazLoader supports SideStore and LiveContainer pairing placement."
                           Foreground="#66666E"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"/>

            </StackPanel>

        </Border>


        <Grid Grid.Row="4"
              Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Export Pairing Backup"
                    Style="{StaticResource PairingButtonSecondary}"
                    Click="ExportPairingButton_Click"
                    HorizontalAlignment="Left"/>

            <Button Grid.Column="1"
                    Content="Rescan"
                    Style="{StaticResource PairingButtonSecondary}"
                    Click="RescanButton_Click"/>

            <Button Grid.Column="3"
                    Content="Close"
                    Style="{StaticResource PairingButton}"
                    Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>
