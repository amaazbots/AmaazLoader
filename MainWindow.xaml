<Window x:Class="AmaazLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmaazLoader"
        Icon="Assets/AmaazLoader.ico"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="720"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#050506"
        Foreground="#F5F5F7"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLOR SYSTEM                                              -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PageBrush"
                         Color="#050506"/>

        <SolidColorBrush x:Key="SidebarBrush"
                         Color="#08080A"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#0E0E11"/>

        <SolidColorBrush x:Key="SurfaceRaisedBrush"
                         Color="#121216"/>

        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#17171C"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#242429"/>

        <SolidColorBrush x:Key="BorderHoverBrush"
                         Color="#34343A"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F5F5F7"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#8B8B92"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#5E5E66"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#73F5A4"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#FF6961"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#FFFFFF"/>


        <!-- ========================================================= -->
        <!-- SCROLLBAR                                                -->
        <!-- ========================================================= -->

        <Style x:Key="AmaazScrollBar"
               TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="False"
                                        Focusable="False"
                                        Opacity="0"/>

                                </Track.DecreaseRepeatButton>


                                <Track.Thumb>

                                    <Thumb Margin="2">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border x:Name="ThumbBorder"
                                                        Width="5"
                                                        MinHeight="34"
                                                        Background="#35353B"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Center"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#626269"/>

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Width"
                                                                Value="6"/>

                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#8A8A91"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>


                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="False"
                                        Focusable="False"
                                        Opacity="0"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- CARD                                                      -->
        <!-- ========================================================= -->

        <Style x:Key="AmaazCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="20"/>

            <Setter Property="Padding"
                    Value="24"/>

        </Style>


        <Style x:Key="AmaazCardInteractive"
               TargetType="Border"
               BasedOn="{StaticResource AmaazCard}">

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#111115"/>

                    <Setter Property="BorderBrush"
                            Value="#303036"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- BUTTONS                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="DarkButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#1B1B20"/>

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="BorderBrush"
                    Value="#303036"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="20,11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#25252B"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3A3A41"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303037"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="SidebarButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="50"/>

            <Setter Property="Height"
                    Value="50"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#74747B"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SidebarBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SidebarBorder"
                                        Property="Background"
                                        Value="#17171B"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="SidebarBorder"
                                        Property="Background"
                                        Value="#222227"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- TYPOGRAPHY                                                -->
        <!-- ========================================================= -->

        <Style x:Key="EyebrowText"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#6C6C74"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>


        <Style x:Key="CardTitle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- ========================================================= -->
        <!-- PROGRESS BAR                                              -->
        <!-- ========================================================= -->

        <Style x:Key="AmaazProgressBar"
               TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="7"/>

            <Setter Property="Minimum"
                    Value="0"/>

            <Setter Property="Maximum"
                    Value="100"/>

            <Setter Property="Background"
                    Value="#242429"/>

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Grid>

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>

                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- ROOT                                                          -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource PageBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- SIDEBAR                                                   -->
        <!-- ========================================================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#17171B"
                BorderThickness="0,0,1,0">

            <Grid Margin="0,20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        Width="52"
                        Height="52"
                        CornerRadius="15"
                        Background="#F5F5F7"
                        HorizontalAlignment="Center">

                    <Image Source="Assets/AmaazLoader.ico"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"/>

                </Border>


                <StackPanel Grid.Row="1"
                            VerticalAlignment="Top"
                            Margin="0,42,0,0">

                    <Border Width="50"
                            Height="50"
                            CornerRadius="14"
                            Background="#F5F5F7"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">

                        <TextBlock Text="A"
                                   Foreground="#080809"
                                   FontSize="17"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <Button x:Name="InstallersButton"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="Install Apps"
                            Click="InstallersButton_Click"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="↓"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Apps"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Border Width="50"
                            Height="50"
                            CornerRadius="14"
                            Background="#121216"
                            HorizontalAlignment="Center">

                        <TextBlock Text="•••"
                                   Foreground="#72727A"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </StackPanel>


                <Button x:Name="SettingsButton"
                        Grid.Row="2"
                        Content="⚙"
                        Style="{StaticResource SidebarButton}"
                        FontSize="18"
                        ToolTip="Settings"
                        Click="SettingsButton_Click"
                        HorizontalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN AREA                                                 -->
        <!-- ========================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- TOP BAR                                               -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    Background="#09090B"
                    BorderBrush="#17171B"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="AmaazLoader"
                                   Foreground="#F5F5F7"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Border Width="1"
                                Height="20"
                                Background="#29292E"
                                Margin="16,0"/>

                        <TextBlock Text="v1.1.0"
                                   Foreground="#626269"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Background="#101014"
                            BorderBrush="#242429"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="13,8"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse x:Name="DeviceStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#626269"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="DeviceStatusText"
                                       Text="Disconnected"
                                       Foreground="#8B8B92"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- CONTENT                                               -->
            <!-- ===================================================== -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,32,22,40">

                <ScrollViewer.Resources>

                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource AmaazScrollBar}"/>

                </ScrollViewer.Resources>


                <Grid MaxWidth="1520"
                      HorizontalAlignment="Center">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- PAGE HEADER                                       -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,30">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="READY TO SIDELOAD"
                                       Style="{StaticResource EyebrowText}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Install your IPA"
                                       Foreground="#F5F5F7"
                                       FontSize="40"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Sign and install apps directly to your iPhone or iPad."
                                       Foreground="#7A7A82"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">

                            <TextBlock x:Name="DeviceNameText"
                                       Text="No iPhone detected"
                                       Foreground="#F5F5F7"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock x:Name="DeviceUdidText"
                                       Text="Waiting for device..."
                                       Foreground="#5C5C64"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="350"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- IPA SELECTOR                                       -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Style="{StaticResource AmaazCardInteractive}"
                            Margin="0,0,0,16"
                            Padding="22">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Border Grid.Column="0"
                                    Width="58"
                                    Height="58"
                                    CornerRadius="16"
                                    Background="#F5F5F7"
                                    Margin="0,0,18,0">

                                <TextBlock Text="A"
                                           Foreground="#080809"
                                           FontSize="20"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="CHOOSE AN IPA FILE"
                                           Style="{StaticResource EyebrowText}"
                                           Margin="0,0,0,6"/>

                                <TextBlock x:Name="SelectedIpaText"
                                           Text="No IPA selected"
                                           Foreground="#F5F5F7"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="Select an app package to begin."
                                           Foreground="#66666E"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Style="{StaticResource DarkButton}"
                                    Click="SelectIpaButton_Click"
                                    VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- QUICK INSTALL                                      -->
                    <!-- ================================================= -->

                    <Border Grid.Row="2"
                            Style="{StaticResource AmaazCard}"
                            Margin="0,0,0,16"
                            Padding="22">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0"
                                  Margin="0,0,0,18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="QUICK INSTALL"
                                               Style="{StaticResource EyebrowText}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Text="Popular apps"
                                               Foreground="#F5F5F7"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Pick an app and AmaazLoader will download the latest official IPA for you."
                                               Foreground="#66666E"
                                               FontSize="11"
                                               Margin="0,6,0,0"/>

                                </StackPanel>


                                <Button Grid.Column="1"
                                        Content="Browse All Apps"
                                        Style="{StaticResource DarkButton}"
                                        Padding="16,9"
                                        FontSize="11"
                                        Click="InstallersButton_Click"
                                        VerticalAlignment="Center"/>

                            </Grid>


                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <Border Grid.Column="0"
                                        Background="#111115"
                                        BorderBrush="#2A2A30"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="17">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="13"
                                                Background="#15151A"
                                                Margin="0,0,14,0"
                                                ClipToBounds="True">

                                            <Image Source="https://raw.githubusercontent.com/SideStore/SideStore/develop/AltStore/Resources/Icons.xcassets/AppIcon.appiconset/180.png"
                                                   Stretch="UniformToFill"/>

                                        </Border>


                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="SideStore"
                                                           Foreground="#F5F5F7"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>

                                                <Border Background="#102016"
                                                        BorderBrush="#285038"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="7,3"
                                                        Margin="9,0,0,0">

                                                    <TextBlock Text="RECOMMENDED"
                                                               Foreground="#73F5A4"
                                                               FontSize="8"
                                                               FontWeight="Bold"/>

                                                </Border>

                                            </StackPanel>

                                            <TextBlock Text="Alternative app store for iPhone and iPad."
                                                       Foreground="#66666E"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>


                                        <Button x:Name="QuickInstallSideStoreButton"
                                                Grid.Column="2"
                                                Content="Install"
                                                Background="#F5F5F7"
                                                Foreground="#080809"
                                                BorderThickness="0"
                                                Padding="17,9"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="QuickInstallSideStoreButton_Click"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>


                                <Border Grid.Column="2"
                                        Background="#111115"
                                        BorderBrush="#2A2A30"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="17">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="13"
                                                Background="#15151A"
                                                Margin="0,0,14,0"
                                                ClipToBounds="True">

                                            <Image Source="https://raw.githubusercontent.com/LiveContainer/LiveContainer/main/Resources/Assets.xcassets/AppIcon.appiconset/AppIcon1024.png"
                                                   Stretch="UniformToFill"/>

                                        </Border>


                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="LiveContainer"
                                                       Foreground="#F5F5F7"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Run and manage multiple apps from one container."
                                                       Foreground="#66666E"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>


                                        <Button x:Name="QuickInstallLiveContainerButton"
                                                Grid.Column="2"
                                                Content="Install"
                                                Background="#F5F5F7"
                                                Foreground="#080809"
                                                BorderThickness="0"
                                                Padding="17,9"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="QuickInstallLiveContainerButton_Click"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </Grid>


                            <Grid Grid.Row="2"
                                  Margin="0,16,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="QuickInstallStatusText"
                                           Text="Choose an app above to download and prepare it for sideloading."
                                           Foreground="#5F5F67"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>

                                <ProgressBar x:Name="QuickInstallProgressBar"
                                             Grid.Column="1"
                                             Style="{StaticResource AmaazProgressBar}"
                                             Height="6"
                                             Value="0"
                                             VerticalAlignment="Center"/>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- THREE WORKFLOW CARDS                              -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="3"
                          Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="155">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="01"
                                               Foreground="#505058"
                                               FontSize="11"
                                               FontWeight="Bold"/>

                                    <Ellipse x:Name="AppleAccountStatusDot"
                                             Grid.Column="1"
                                             Width="8"
                                             Height="8"
                                             Fill="#626269"
                                             VerticalAlignment="Center"/>

                                </Grid>


                                <TextBlock Text="Apple Account"
                                           Foreground="#F5F5F7"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,22,0,0"/>

                                <TextBlock x:Name="AppleAccountStatusText"
                                           Text="Not connected"
                                           Foreground="#8B8B92"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                                <TextBlock x:Name="AppleAccountDetailsText"
                                           Text="Connect your Apple Account to enable signing."
                                           Foreground="#5D5D65"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,9,0,0"/>

                            </StackPanel>

                        </Border>


                        <Border Grid.Column="2"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="155">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="02"
                                               Foreground="#505058"
                                               FontSize="11"
                                               FontWeight="Bold"/>

                                    <Ellipse x:Name="SigningStatusDot"
                                             Grid.Column="1"
                                             Width="8"
                                             Height="8"
                                             Fill="#626269"
                                             VerticalAlignment="Center"/>

                                </Grid>


                                <TextBlock Text="Automatic Signing"
                                           Foreground="#F5F5F7"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,22,0,0"/>

                                <TextBlock x:Name="SigningStatusText"
                                           Text="Signing not configured"
                                           Foreground="#8B8B92"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                                <TextBlock x:Name="SigningDetailsText"
                                           Text="Ready when your account and IPA are selected."
                                           Foreground="#5D5D65"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,9,0,0"/>

                            </StackPanel>

                        </Border>


                        <Border Grid.Column="4"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="155">

                            <StackPanel>

                                <TextBlock Text="03"
                                           Foreground="#505058"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock Text="USB Install"
                                           Foreground="#F5F5F7"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,22,0,0"/>

                                <TextBlock Text="Device detection"
                                           Foreground="#8B8B92"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                                <TextBlock Text="AmaazLoader automatically targets your connected USB device."
                                           Foreground="#5D5D65"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,9,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- APP INFO + ACCOUNT                                 -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="4"
                          Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="150">

                            <StackPanel>

                                <TextBlock Text="APPLICATION"
                                           Style="{StaticResource EyebrowText}"
                                           Margin="0,0,0,16"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock x:Name="AppNameText"
                                                   Text="No application selected"
                                                   Foreground="#F5F5F7"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="BundleIdText"
                                                   Text="—"
                                                   Foreground="#66666E"
                                                   FontSize="11"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>


                                    <Border Grid.Column="1"
                                            Background="#141418"
                                            BorderBrush="#27272C"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="16,11">

                                        <StackPanel Orientation="Horizontal">

                                            <StackPanel Margin="0,0,26,0">

                                                <TextBlock Text="VERSION"
                                                           Style="{StaticResource EyebrowText}"/>

                                                <TextBlock x:Name="VersionText"
                                                           Text="—"
                                                           Foreground="#F5F5F7"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,5,0,0"/>

                                            </StackPanel>


                                            <StackPanel>

                                                <TextBlock Text="SIZE"
                                                           Style="{StaticResource EyebrowText}"/>

                                                <TextBlock x:Name="FileSizeText"
                                                           Text="—"
                                                           Foreground="#F5F5F7"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,5,0,0"/>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <Border Grid.Column="2"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="150">

                            <StackPanel>

                                <TextBlock Text="APPLE ACCOUNT"
                                           Style="{StaticResource EyebrowText}"
                                           Margin="0,0,0,13"/>

                                <TextBlock Text="Use your own Apple Account"
                                           Foreground="#F5F5F7"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Your password is used only during authentication and is not saved by AmaazLoader."
                                           Foreground="#696970"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,16"/>


                                <Button x:Name="AppleAccountButton"
                                        Content="Connect Apple Account"
                                        Style="{StaticResource DarkButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="AppleAccountButton_Click"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- PROGRESS                                           -->
                    <!-- ================================================= -->

                    <Border x:Name="SideloadProgressCard"
                            Grid.Row="5"
                            Style="{StaticResource AmaazCard}"
                            Margin="0,0,0,16"
                            MinHeight="170">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock Text="SIDELOAD PROGRESS"
                                               Style="{StaticResource EyebrowText}"
                                               Margin="0,0,0,8"/>

                                    <TextBlock x:Name="SideloadStageText"
                                               Text="Ready to sideload"
                                               Foreground="#F5F5F7"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                </StackPanel>


                                <TextBlock x:Name="SideloadPercentageText"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#F5F5F7"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,2"/>

                            </Grid>


                            <ProgressBar x:Name="SideloadProgressBar"
                                         Style="{StaticResource AmaazProgressBar}"
                                         Value="0"
                                         Margin="0,22,0,0"/>


                            <TextBlock x:Name="SideloadProgressDetailsText"
                                       Text="Ready to sideload your IPA."
                                       Foreground="#66666E"
                                       FontSize="11"
                                       Margin="0,10,0,0"/>


                            <Grid Margin="0,23,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">

                                    <Ellipse x:Name="ProgressPreparingDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#29292E"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Preparing"
                                               Foreground="#62626A"
                                               FontSize="10"/>

                                </StackPanel>


                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">

                                    <Ellipse x:Name="ProgressAuthenticatingDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#29292E"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Authenticating"
                                               Foreground="#62626A"
                                               FontSize="10"/>

                                </StackPanel>


                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">

                                    <Ellipse x:Name="ProgressSigningDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#29292E"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Signing"
                                               Foreground="#62626A"
                                               FontSize="10"/>

                                </StackPanel>


                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal">

                                    <Ellipse x:Name="ProgressInstallingDot"
                                             Width="8"
                                             Height="8"
                                             Fill="#29292E"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Installing"
                                               Foreground="#62626A"
                                               FontSize="10"/>

                                </StackPanel>

                            </Grid>


                            <Border x:Name="SideloadSuccessPanel"
                                    Background="#0D1A12"
                                    BorderBrush="#1E4B2D"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    Padding="14"
                                    Margin="0,20,0,0"
                                    Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <Border Width="28"
                                            Height="28"
                                            Background="#153321"
                                            CornerRadius="14"
                                            Margin="0,0,11,0">

                                        <TextBlock Text="✓"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock x:Name="SideloadSuccessText"
                                               Grid.Column="1"
                                               Text="Installation completed successfully."
                                               Foreground="#D9FFE5"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- ADVANCED + FINAL ACTION                            -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Style="{StaticResource AmaazCard}"
                                MinHeight="180">

                            <StackPanel>

                                <TextBlock Text="ADVANCED SIGNING"
                                           Style="{StaticResource EyebrowText}"
                                           Margin="0,0,0,16"/>


                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock Text="Signing Certificate"
                                                   Style="{StaticResource CardTitle}"/>

                                        <TextBlock x:Name="SigningCertificateText"
                                                   Text="No certificate selected"
                                                   Foreground="#63636B"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>


                                    <Button Grid.Column="1"
                                            Content="Select"
                                            Style="{StaticResource DarkButton}"
                                            Padding="15,8"
                                            FontSize="11"
                                            Click="SelectSigningCertificateButton_Click"/>

                                </Grid>


                                <Border Height="1"
                                        Background="#1E1E23"
                                        Margin="0,0,0,15"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock Text="Provisioning Profile"
                                                   Style="{StaticResource CardTitle}"/>

                                        <TextBlock x:Name="ProvisioningProfileText"
                                                   Text="No provisioning profile selected"
                                                   Foreground="#63636B"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>


                                    <Button Grid.Column="1"
                                            Content="Select"
                                            Style="{StaticResource DarkButton}"
                                            Padding="15,8"
                                            FontSize="11"
                                            Click="SelectProvisioningProfileButton_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <!-- FINAL ACTION -->

                        <Border Grid.Column="2"
                                Background="#101014"
                                BorderBrush="#2A2A30"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="24"
                                MinHeight="180">

                            <StackPanel>

                                <TextBlock Text="READY?"
                                           Foreground="#66666E"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Sideload your IPA"
                                           Foreground="#F5F5F7"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,11,0,0"/>

                                <TextBlock x:Name="StatusText"
                                           Text="Connect your iPhone and select an IPA to continue."
                                           Foreground="#74747B"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,19"/>


                                <Button x:Name="SideloadButton"
                                        Content="Sideload IPA"
                                        Background="#F5F5F7"
                                        Foreground="#080809"
                                        BorderBrush="#FFFFFF"
                                        BorderThickness="1"
                                        Padding="22,13"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="SideloadButton_Click">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="SideloadButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}">

                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                         Value="True">

                                                    <Setter TargetName="SideloadButtonBorder"
                                                            Property="Background"
                                                            Value="#FFFFFF"/>

                                                </Trigger>

                                                <Trigger Property="IsPressed"
                                                         Value="True">

                                                    <Setter TargetName="SideloadButtonBorder"
                                                            Property="Background"
                                                            Value="#D8D8DC"/>

                                                </Trigger>

                                                <Trigger Property="IsEnabled"
                                                         Value="False">

                                                    <Setter TargetName="SideloadButtonBorder"
                                                            Property="Background"
                                                            Value="#25252A"/>

                                                    <Setter TargetName="SideloadButtonBorder"
                                                            Property="BorderBrush"
                                                            Value="#25252A"/>

                                                    <Setter Property="Foreground"
                                                            Value="#626269"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>