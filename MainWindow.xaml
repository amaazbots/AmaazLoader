<Window x:Class="AmaazLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AmaazLoader"
        Icon="Assets/AmaazLoader.ico"
        Width="1400"
        Height="900"
        MinWidth="1120"
        MinHeight="760"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#050506"
        Foreground="#F5F5F7"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">

    <Window.Resources>

        <SolidColorBrush x:Key="PageBrush" Color="#050506"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#08080A"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0E0E11"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#121216"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#17171C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#242429"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B8B92"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5E5E66"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#73F5A4"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB86B"/>

        <Style x:Key="Card"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="NavButton"
               TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#85858D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#141418"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1B1B20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#080809"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#DADADF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Background" Value="#18181D"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#303036"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#222228"/>
                                <Setter TargetName="SecondaryBorder" Property="BorderBrush" Value="#3A3A42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#292930"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadio"
               TargetType="RadioButton">
            <Setter Property="Foreground" Value="#7A7A83"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="#1B1B20"/>
                                <Setter Property="Foreground"
                                        Value="#F5F5F7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="#F5F5F7"/>
                                <Setter Property="Foreground"
                                        Value="#080809"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#242429"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Eyebrow"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62626A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#17171B"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="4,0,0,30">

                    <Border Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="#F5F5F7">
                        <Image Source="Assets/AmaazLoader.ico"
                               Width="36"
                               Height="36"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="AmaazLoader"
                                   Foreground="#F5F5F7"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="iOS Sideloading"
                                   Foreground="#57575F"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="AppVersionText"
                                   Text="v1.2.0"
                                   Foreground="#3F3F46"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Row="1">

                    <Border Height="46"
                            Background="#F5F5F7"
                            CornerRadius="12"
                            Padding="14,0"
                            Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⌂"
                                       Foreground="#080809"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Width="28"/>
                            <TextBlock Text="Home"
                                       Foreground="#080809"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="InstallersButton"
                            Style="{StaticResource NavButton}"
                            ToolTip="Browse installable apps"
                            Click="InstallersButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Width="28"/>
                            <TextBlock Text="Apps"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PairingButton"
                            Style="{StaticResource NavButton}"
                            ToolTip="Manage pairing files"
                            Click="PairingButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↔"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Width="28"/>
                            <TextBlock Text="Pairing"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Border Grid.Row="3"
                        Background="#0D0D10"
                        BorderBrush="#202025"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#626269"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceStatusText"
                                       Text="Disconnected"
                                       Foreground="#8B8B92"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button x:Name="SettingsButton"
                                Grid.Row="1"
                                Style="{StaticResource NavButton}"
                                Height="38"
                                Margin="0,8,0,0"
                                Padding="8,0"
                                ToolTip="Settings"
                                Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙"
                                           FontSize="14"
                                           Width="26"/>
                                <TextBlock Text="Settings"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Optional sponsored link: never opened automatically. -->
                        <Border Grid.Row="2"
                                BorderBrush="#27272C"
                                BorderThickness="0,1,0,0"
                                Margin="0,5,0,0"
                                Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="SPONSORED"
                                           Foreground="#74747C"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="4,0,0,5"/>
                                <Button x:Name="SponsoredLinkButton"
                                        Style="{StaticResource NavButton}"
                                        Height="34"
                                        Margin="0"
                                        Padding="8,0"
                                        ToolTip="Advertisement • Opens an external website"
                                        Click="SponsoredLinkButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↗"
                                                   FontSize="14"
                                                   Width="26"/>
                                        <TextBlock Text="Visit sponsor"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Optional • External website"
                                           FontSize="9"
                                           Foreground="#62626A"
                                           Margin="4,3,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#08080A"
                    BorderBrush="#17171B"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Home"
                                   Foreground="#F5F5F7"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Select an app, connect your account, then sideload."
                                   Foreground="#56565E"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#101014"
                            BorderBrush="#242429"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,9"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="DeviceNameText"
                                       Text="No device connected"
                                       Foreground="#F5F5F7"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="DeviceUdidText"
                                       Text="Connect an iPhone or iPad via USB"
                                       Foreground="#5E5E66"
                                       FontSize="9"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel MaxWidth="1480"
                            Margin="30,26,30,36"
                            HorizontalAlignment="Center">

                    <!-- HERO -->
                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="READY TO SIDELOAD"
                                       Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Install your IPA"
                                       Foreground="#F5F5F7"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="Drop an IPA, choose one from your PC, or use Quick Install."
                                       Foreground="#707078"
                                       FontSize="11"
                                       Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#0C160F"
                                BorderBrush="#1F442A"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="13,9"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#73F5A4"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Local signing • USB install"
                                           Foreground="#B8E8C6"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- IPA DROP ZONE -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,16"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50"
                                    Height="50"
                                    CornerRadius="14"
                                    Background="#17171C"
                                    BorderBrush="#2D2D33"
                                    BorderThickness="1"
                                    Margin="0,0,15,0">
                                <TextBlock Text="IPA"
                                           Foreground="#F5F5F7"
                                           FontSize="11"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedIpaText"
                                           Text="Drop an IPA here or choose a file"
                                           Foreground="#F5F5F7"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="AmaazLoader will read the app metadata automatically."
                                           Foreground="#62626A"
                                           FontSize="10"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Choose IPA"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SelectIpaButton_Click"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="4"
                                    Content="Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearSelectedIpaButton_Click"
                                    VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- QUICK INSTALL -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,17">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="QUICK INSTALL"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="Popular apps"
                                               Foreground="#F5F5F7"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,9,0">

                                        <TextBlock Text="BUILD"
                                                   Foreground="#55555D"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <Border Background="#111115"
                                                BorderBrush="#2B2B31"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="3">

                                            <StackPanel Orientation="Horizontal">

                                                <RadioButton x:Name="QuickInstallStableRadio"
                                                             GroupName="QuickInstallChannel"
                                                             Content="Stable"
                                                             IsChecked="True"
                                                             Style="{StaticResource SegmentRadio}"
                                                             Checked="QuickInstallChannel_Checked"/>

                                                <RadioButton x:Name="QuickInstallNightlyRadio"
                                                             GroupName="QuickInstallChannel"
                                                             Content="Nightly"
                                                             Style="{StaticResource SegmentRadio}"
                                                             Checked="QuickInstallChannel_Checked"/>

                                            </StackPanel>

                                        </Border>

                                    </StackPanel>

                                    <Button Content="Browse All"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="InstallersButton_Click"/>

                                </StackPanel>

                            </Grid>

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#111115"
                                        BorderBrush="#294034"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="17">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="13"
                                                Background="#15151A"
                                                ClipToBounds="True"
                                                Margin="0,0,14,0">
                                            <Image Source="https://raw.githubusercontent.com/SideStore/SideStore/develop/AltStore/Resources/Icons.xcassets/AppIcon.appiconset/180.png"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="SideStore"
                                                           Foreground="#F5F5F7"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="#102016"
                                                        BorderBrush="#285038"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="7,3"
                                                        Margin="9,0,0,0">
                                                    <TextBlock Text="RECOMMENDED"
                                                               Foreground="#73F5A4"
                                                               FontSize="8"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="Alternative app store with automatic pairing setup."
                                                       Foreground="#6B6B73"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock x:Name="SideStoreInstalledBadge"
                                                       Text="Device status: checking..."
                                                       Foreground="#5F5F67"
                                                       FontSize="9"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                        <Button x:Name="QuickInstallSideStoreButton"
                                                Grid.Column="2"
                                                Content="Install"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="110"
                                                Click="QuickInstallSideStoreButton_Click"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                                <Border Grid.Column="2"
                                        Background="#111115"
                                        BorderBrush="#2A2A30"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="17">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="13"
                                                Background="#15151A"
                                                ClipToBounds="True"
                                                Margin="0,0,14,0">
                                            <Image Source="https://raw.githubusercontent.com/LiveContainer/LiveContainer/main/Resources/Assets.xcassets/AppIcon.appiconset/AppIcon1024.png"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="LiveContainer"
                                                       Foreground="#F5F5F7"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="LiveContainer + SideStore with automatic pairing."
                                                       Foreground="#6B6B73"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock x:Name="LiveContainerInstalledBadge"
                                                       Text="Device status: checking..."
                                                       Foreground="#5F5F67"
                                                       FontSize="9"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <Button x:Name="QuickInstallLiveContainerButton"
                                                Grid.Column="2"
                                                Content="Install"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="110"
                                                Click="QuickInstallLiveContainerButton_Click"
                                                VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,15,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="QuickInstallStatusText"
                                           Text="Choose an app above to download and prepare it for sideloading."
                                           Foreground="#5F5F67"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>

                                <ProgressBar x:Name="QuickInstallProgressBar"
                                             Grid.Column="1"
                                             Style="{StaticResource ProgressBarStyle}"
                                             Value="0"
                                             VerticalAlignment="Center"/>

                                <Button x:Name="QuickFixPairingButton"
                                        Grid.Column="3"
                                        Content="Fix Pairing"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,8"
                                        Click="QuickFixPairingButton_Click"/>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Sponsored display placement (728x90); no impact on sideloading. -->
                    <Border Style="{StaticResource Card}"
                            Padding="14"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="ADVERTISEMENT"
                                       Style="{StaticResource Eyebrow}"
                                       Margin="0,0,0,9"/>
                            <Grid Width="728" Height="90"
                                  Background="#0B0B0E">
                                <TextBlock x:Name="DisplayAdFallback"
                                           Text="Sponsored content"
                                           Foreground="#62626A"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <wv2:WebView2 x:Name="DisplayAdWebView"
                                              Width="728"
                                              Height="90"
                                              Loaded="DisplayAdWebView_Loaded"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- READINESS ROW -->
                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Padding="18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="AppleAccountStatusDot"
                                         Width="10"
                                         Height="10"
                                         Fill="#626269"
                                         Margin="0,3,11,0"
                                         VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="APPLE ACCOUNT"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="AppleAccountStatusText"
                                               Text="NOT CONNECTED"
                                               Foreground="#9B9BA3"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}"
                                Padding="18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="SigningStatusDot"
                                         Width="10"
                                         Height="10"
                                         Fill="#626269"
                                         Margin="0,3,11,0"
                                         VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SIGNING"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="SigningStatusText"
                                               Text="Checking..."
                                               Foreground="#9B9BA3"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock x:Name="SigningDetailsText"
                                               Text="Checking signing readiness..."
                                               Foreground="#5F5F67"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               MaxHeight="30"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}"
                                Padding="18">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="#73F5A4"
                                         Margin="0,3,11,0"
                                         VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="INSTALL METHOD"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="Direct USB"
                                               Foreground="#F5F5F7"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                        </Border>

                    </Grid>

                    <!-- APP + ACCOUNT -->
                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="APPLICATION"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="AppNameText"
                                           Text="No app selected"
                                           Foreground="#F5F5F7"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>

                                <Grid Margin="0,18,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BUNDLE ID"
                                                   Style="{StaticResource Eyebrow}"/>
                                        <TextBlock x:Name="BundleIdText"
                                                   Text="—"
                                                   Foreground="#9A9AA2"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,5,12,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VERSION"
                                                   Style="{StaticResource Eyebrow}"/>
                                        <TextBlock x:Name="VersionText"
                                                   Text="—"
                                                   Foreground="#9A9AA2"
                                                   FontSize="10"
                                                   Margin="0,5,12,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SIZE"
                                                   Style="{StaticResource Eyebrow}"/>
                                        <TextBlock x:Name="FileSizeText"
                                                   Text="—"
                                                   Foreground="#9A9AA2"
                                                   FontSize="10"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="APPLE ACCOUNT"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="Automatic signing"
                                               Foreground="#F5F5F7"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,7,0,0"/>
                                    <TextBlock x:Name="AppleAccountDetailsText"
                                               Text="Connect your Apple Account to enable automatic signing."
                                               Foreground="#6B6B73"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,7,18,0"/>
                                </StackPanel>

                                <Button x:Name="AppleAccountButton"
                                        Grid.Column="1"
                                        Content="  Connect"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="AppleAccountButton_Click"
                                        VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- PROGRESS -->
                    <Border x:Name="SideloadProgressCard"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="INSTALLATION"
                                               Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="SideloadStageText"
                                               Text="Preparing..."
                                               Foreground="#F5F5F7"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="SideloadPercentageText"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#F5F5F7"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           VerticalAlignment="Bottom"/>
                            </Grid>

                            <ProgressBar x:Name="SideloadProgressBar"
                                         Grid.Row="1"
                                         Style="{StaticResource ProgressBarStyle}"
                                         Height="8"
                                         Value="0"
                                         Margin="0,18,0,0"/>

                            <Grid Grid.Row="2"
                                  Margin="0,15,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="SideloadProgressDetailsText"
                                               Text="Preparing AmaazLoader..."
                                               Foreground="#717179"
                                               FontSize="10"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,13,0,0">
                                        <Ellipse x:Name="ProgressPreparingDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#5B5B63"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="Prepare"
                                                   Foreground="#6F6F77"
                                                   FontSize="9"
                                                   Margin="0,0,16,0"/>
                                        <Ellipse x:Name="ProgressAuthenticatingDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#5B5B63"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="Authenticate"
                                                   Foreground="#6F6F77"
                                                   FontSize="9"
                                                   Margin="0,0,16,0"/>
                                        <Ellipse x:Name="ProgressSigningDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#5B5B63"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="Sign"
                                                   Foreground="#6F6F77"
                                                   FontSize="9"
                                                   Margin="0,0,16,0"/>
                                        <Ellipse x:Name="ProgressInstallingDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#5B5B63"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="Install"
                                                   Foreground="#6F6F77"
                                                   FontSize="9"
                                                   Margin="0,0,16,0"/>
                                        <Ellipse x:Name="ProgressPairingDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#5B5B63"
                                                 Margin="0,0,7,0"/>
                                        <TextBlock Text="Pair"
                                                   Foreground="#6F6F77"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border x:Name="SideloadSuccessPanel"
                                        Grid.Column="1"
                                        Background="#0F2116"
                                        BorderBrush="#265638"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="SideloadSuccessText"
                                               Text="Installed ✓"
                                               Foreground="#73F5A4"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>

                            </Grid>

                        </Grid>

                    </Border>

                    <!-- ADVANCED -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,16"
                            Padding="0">

                        <StackPanel>

                            <Button x:Name="AdvancedOptionsButton"
                                    Content="Advanced signing options  +"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="18"
                                    HorizontalAlignment="Stretch"
                                    Click="AdvancedOptionsButton_Click"/>

                            <StackPanel x:Name="AdvancedSigningPanel"
                                        Visibility="Collapsed"
                                        Margin="18,0,18,18">

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Signing certificate"
                                               Foreground="#8C8C94"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="SigningCertificateText"
                                               Grid.Column="1"
                                               Text="Automatic / Apple Account"
                                               Foreground="#F5F5F7"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="Choose"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="SelectSigningCertificateButton_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Provisioning profile"
                                               Foreground="#8C8C94"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="ProvisioningProfileText"
                                               Grid.Column="1"
                                               Text="Automatic / Apple Account"
                                               Foreground="#F5F5F7"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="Choose"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="SelectProvisioningProfileButton_Click"/>
                                </Grid>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- FINAL CTA -->
                    <Border Background="#F5F5F7"
                            CornerRadius="20"
                            Padding="22">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="READY?"
                                           Foreground="#65656D"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Sign and install to your iPhone"
                                           Foreground="#080809"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                                <TextBlock x:Name="StatusText"
                                           Text="Select an IPA to begin."
                                           Foreground="#5A5A62"
                                           FontSize="10"
                                           Margin="0,6,18,0"/>
                            </StackPanel>

                            <Button x:Name="SideloadButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    Click="SideloadButton_Click"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalAlignment="Center">

                                <Border x:Name="SideloadButtonBorder"
                                        Background="#080809"
                                        CornerRadius="14"
                                        Padding="24,14">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sideload IPA"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="  →"
                                                   Foreground="#73F5A4"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                </Border>

                            </Button>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
