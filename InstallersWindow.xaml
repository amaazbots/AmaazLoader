<Window x:Class="AmaazLoader.InstallersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AmaazLoader Installers"
        Icon="Assets/AmaazLoader.ico"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#050506"
        Foreground="#F5F5F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="InstallerButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#080809"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D8D8DC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#050506">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="94"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#09090B"
                BorderBrush="#1A1A1F"
                BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INSTALLERS"
                               Foreground="#73737B"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock Text="Discover &amp; install"
                               Foreground="#F5F5F7"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource InstallerButton}"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30,26,20,28">
            <StackPanel MaxWidth="1400"
                        HorizontalAlignment="Center">

                <Border Background="#0D1510"
                        BorderBrush="#23432D"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="22"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="12"
                                Background="#14251A">
                            <TextBlock Text="✓"
                                       Foreground="#73F5A4"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0">
                            <TextBlock Text="Official release sources"
                                       Foreground="#F5F5F7"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="AmaazLoader resolves IPA files directly from each project's official GitHub releases and verifies SHA-256 when GitHub provides a digest."
                                       Foreground="#8A8A92"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="FEATURED"
                           Foreground="#686870"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="2,0,0,14"/>

                <WrapPanel x:Name="InstallerCardsPanel"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#09090B"
                BorderBrush="#1A1A1F"
                BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="InstallerStatusText"
                               Text="Loading installer catalog..."
                               Foreground="#F5F5F7"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="InstallerDetailsText"
                               Text="Official sources only."
                               Foreground="#6F6F77"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Column="1"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#222228"
                             Foreground="#73F5A4"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
