<Window x:Class="AmaazLoader.InstallersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Apps - AmaazLoader"
        Icon="Assets/AmaazLoader.ico"
        Width="1020"
        Height="740"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#050506"
        Foreground="#F5F5F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#080809"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D8D8DC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Background" Value="#17171C"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#303036"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#222228"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3B3B42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#292930"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#242429"/>
            <Setter Property="Foreground" Value="#73F5A4"/>
        </Style>

    </Window.Resources>


    <Grid Background="#050506">

        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="104"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#09090B"
                BorderBrush="#1A1A1F"
                BorderThickness="0,0,0,1">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="AMAAZLOADER"
                               Foreground="#6C6C74"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock Text="Install Apps"
                               Foreground="#F5F5F7"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Choose an app. AmaazLoader downloads the official IPA and prepares it for sideloading."
                               Foreground="#74747C"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="30,26,20,30">

            <StackPanel MaxWidth="1400"
                        HorizontalAlignment="Center">


                <Border Background="#0E0E11"
                        BorderBrush="#242429"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Margin="0,0,0,26">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#17171C"
                                    Margin="0,0,12,0">

                                <TextBlock Text="1"
                                           Foreground="#F5F5F7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel>
                                <TextBlock Text="Pick an app"
                                           Foreground="#F5F5F7"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Choose what you want to install."
                                           Foreground="#696971"
                                           FontSize="10"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Background="#242429"
                                Margin="18,0"/>


                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#17171C"
                                    Margin="0,0,12,0">

                                <TextBlock Text="2"
                                           Foreground="#F5F5F7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel>
                                <TextBlock Text="Download &amp; verify"
                                           Foreground="#F5F5F7"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Official GitHub release only."
                                           Foreground="#696971"
                                           FontSize="10"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                        </StackPanel>


                        <Border Grid.Column="3"
                                Background="#242429"
                                Margin="18,0"/>


                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#102016"
                                    Margin="0,0,12,0">

                                <TextBlock Text="3"
                                           Foreground="#73F5A4"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel>
                                <TextBlock Text="Sideload"
                                           Foreground="#F5F5F7"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Finish from the main screen."
                                           Foreground="#696971"
                                           FontSize="10"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>


                <Grid Margin="2,0,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="FEATURED APPS"
                                   Foreground="#686870"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Official releases, ready for AmaazLoader"
                                   Foreground="#4F4F57"
                                   FontSize="10"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#0D1711"
                            BorderBrush="#20422B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="11,7"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#73F5A4"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Official sources"
                                       Foreground="#BDEECC"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <WrapPanel x:Name="InstallerCardsPanel"/>

            </StackPanel>

        </ScrollViewer>


        <Border Grid.Row="2"
                Background="#09090B"
                BorderBrush="#1A1A1F"
                BorderThickness="0,1,0,0">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>


                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="InstallerStatusText"
                               Text="Loading apps..."
                               Foreground="#F5F5F7"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="InstallerDetailsText"
                               Text="Please wait a moment."
                               Foreground="#6F6F77"
                               FontSize="10"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="DOWNLOAD"
                               Foreground="#5D5D65"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="0,0,0,7"/>

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Style="{StaticResource SimpleProgressBar}"
                                 Value="0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
